Options -Indexes
RewriteEngine On

# One canonical host: https + www (301, not the old 302)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.acuratechglobal.com%{REQUEST_URI} [R=301,L]

# /index and /index.php -> /
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/index(\.php|\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# Strip .php/.html from URLs (GET only, so form POSTs to contact_mail.php keep working)
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/([^\s?]+)\.(php|html)[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve extensionless URLs internally
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+)$ $1.php [L]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+)$ $1.html [L]

# Keep includes private; 404 only for missing pages (the old 500->404 rule hid real errors)
RewriteRule ^includes/ - [F,L]
ErrorDocument 404 /404.php
